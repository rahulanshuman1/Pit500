# MongoDB Atlas connection string (include the database name, e.g. /pit500)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pit500?retryWrites=true&w=majority

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Extra allowed frontend origins, comma separated, no trailing slash
FRONTEND_URLS=https://pit500.vercel.app

# Password used ONLY when the first admin (admin_pit500) is auto-created
ADMIN_DEFAULT_PASSWORD=Pit500@Admin2026

PORT=5000
